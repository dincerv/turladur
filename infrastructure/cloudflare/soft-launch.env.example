# Railway / Fly — soft launch (domain onay öncesi)
# Kopyala → host secret’larına yapıştır. Gerçek secret commit etme.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler…/neondb?sslmode=require
REDIS_URL=redis://…

JWT_SECRET= # openssl rand -base64 32
JWT_EXPIRES_IN=15m
OTP_SHOW_DEBUG_CODE=false

FRONTEND_URL=https://YOUR-APP.vercel.app
CORS_ALLOW_VERCEL=true
API_PUBLIC_URL=https://YOUR-API.up.railway.app
CDN_URL=https://YOUR-API.up.railway.app/api/v1/storage/media

# Cloudflare R2 — infrastructure/cloudflare/R2_SETUP.md
MINIO_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
S3_BUCKET=tourtech-media
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

# Mail — docs/EMAIL_SETUP.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="turta <learnedfromai@gmail.com>"
EMAIL_BRAND_URL=https://YOUR-APP.vercel.app

# Swagger prod kapalı (açmak için true)
# ENABLE_SWAGGER=false

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
